{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.anishchugh05/mnemolith",
  "title": "Mnemolith",
  "description": "Shared local memory for AI coding tools that stays true to your code.",
  "repository": {
    "url": "https://github.com/anishchugh05/mnemolith",
    "source": "github"
  },
  "websiteUrl": "https://mnemolith.dev/",
  "version": "0.2.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mnemolith",
      "version": "0.2.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
